{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": [
      "ES2022"
    ],
    "types": [
      "node"
    ],
    "rootDir": "app",
    "outDir": "dist"
  },
  "include": [
    "app/main/**/*.ts",
    "app/preload/**/*.ts",
    "app/shared/**/*.ts",
    "app/tree/**/*.ts"
  ]
}
